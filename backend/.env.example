# ==========================================
# CAMPUSFIND BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Application Settings
PROJECT_NAME="CampusFind"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure key in production (e.g., `openssl rand -hex 32`)
SECRET_KEY="campusfind_super_secure_jwt_secret_key_2024_university_ecosystem"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite (Zero-setup local testing)
DATABASE_URL="sqlite:///./campusfind.db"
# Production / Supabase PostgreSQL example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# College Email Domain Verification
# Comma-separated list of allowed domains, e.g., 'campus.edu,stanford.edu,oxford.ac.uk'
# Set to '*' to allow all domains during development/demo testing
ALLOWED_COLLEGE_DOMAINS="*"

# Cloudinary Image Hosting (Optional in dev, required in production)
# If empty, the backend automatically uses safe local static storage fallback
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
